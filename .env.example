# Copy to .env and edit. Bun loads .env automatically on `bun start`.
#
# The app needs no configuration to start: it reads ./data/usage.db in open
# mode on 127.0.0.1:34998. Uncomment only what your deployment changes.

# --- Basics ------------------------------------------------------------------

# Path to the SQLite file written by the LiteLLM callback (opened read-only).
LITELLM_DASH_DB=./data/usage.db

# Listen address. 0.0.0.0 exposes on your network — enable auth first.
#HOST=127.0.0.1
#PORT=34998

# --- Authentication (leave unset for open mode) ------------------------------

# Login screen + session cookie. Both must be set.
LITELLM_DASH_USER=
LITELLM_DASH_PASSWORD=

# Optional shared secret for scripts. Send as `Authorization: Bearer`; a
# `?token=` query parameter is ignored.
#LITELLM_DASH_TOKEN=

# Behind a reverse proxy or tunnel: trust CF-Connecting-IP / X-Forwarded-*
# for login rate limiting and mark cookies Secure.
#LITELLM_DASH_TRUST_PROXY=1

# Session cookie lifetime for "Remember me" (days) and its HMAC key.
# Defaults: 30 days, key derived from the password.
#LITELLM_DASH_SESSION_TTL_DAYS=30
#LITELLM_DASH_SESSION_SECRET=

# --- Model specs (optional: the Models view's context/output/capability data) -

# LiteLLM proxy base URL + master key for GET /model/info, fetched live.
# Without these the Models view shows usage only.
#LITELLM_DASH_PROXY_URL=http://litellm:4000
#LITELLM_DASH_PROXY_TOKEN=

# --- scripts/dev.sh and scripts/deploy.sh ------------------------------------

# SSH target and data dir of the host running LiteLLM (dev.sh).
#DASH_HOST=user@gateway.local
#DASH_REMOTE_DB_DIR=/srv/litellm/data

# Deploy target for deploy.sh (rsync destination + systemd --user unit).
#LITELLM_DASH_DEPLOY_DIR=/opt/litellm-dash
#LITELLM_DASH_UNIT=litellm-dash
