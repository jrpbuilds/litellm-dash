{
  "name": "litellm-dash",
  "version": "1.0.0",
  "description": "Self-hosted usage dashboard for a headless LiteLLM proxy",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:callback": "python3 -m unittest discover -s litellm-callback",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "*",
    "typescript": "^5.9.0"
  }
}
