# Copy to .env and edit. Bun loads .env automatically on `bun start`.

# --- Dashboard ---------------------------------------------------------------

# Path to the SQLite file written by the LiteLLM callback (opened read-only).
LITELLM_DASH_DB=./data/usage.db

# Listen address. Use 0.0.0.0 to expose on your network (enable auth first).
HOST=127.0.0.1
PORT=34998

# --- Authentication (leave all unset for open mode) --------------------------

# Login screen + session cookie. Both must be set.
LITELLM_DASH_USER=
LITELLM_DASH_PASSWORD=

# "Remember me" cookie lifetime in days (1-365).
LITELLM_DASH_SESSION_TTL_DAYS=30

# Optional HMAC key for session cookies. If unset, it is derived from the
# password, so changing the password signs everyone out.
LITELLM_DASH_SESSION_SECRET=

# Optional shared secret for scripts: `?token=...` or `Authorization: Bearer ...`.
LITELLM_DASH_TOKEN=

# Set to 1 when running behind a reverse proxy or tunnel (nginx, Caddy,
# Cloudflare Tunnel). Uses CF-Connecting-IP / X-Forwarded-For for login rate
# limiting and X-Forwarded-Proto to mark cookies Secure.
LITELLM_DASH_TRUST_PROXY=0

# --- LiteLLM callback (set these in the LiteLLM container, not here) ---------

# LITELLM_USAGE_DB=/app/data/usage.db
# LITELLM_USAGE_RETENTION_DAYS=90
# Map upstream api_base prefixes to provider names shown in the dashboard.
# LITELLM_USAGE_PROVIDERS=https://api.example.com=example,https://other.ai=other

# --- scripts/dev.sh and scripts/deploy.sh ------------------------------------

# SSH target and data dir of the host running LiteLLM (dev.sh).
# DASH_HOST=user@gateway.local
# DASH_REMOTE_DB_DIR=/srv/litellm/data

# Deploy target for deploy.sh (rsync destination + systemd --user unit).
# LITELLM_DASH_DEPLOY_DIR=/opt/litellm-dash
# LITELLM_DASH_UNIT=litellm-dash
